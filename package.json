{
  "name": "api-stress-studio",
  "displayName": "API Stress Studio",
  "description": "A powerful API stress testing and performance profiler tool for VS Code.",
  "version": "1.0.0",
  "publisher": "Tomascody-web333",
  "repository": {
    "type": "git",
    "url": "https://github.com/Tomascody-web333/api-stress-studio.git"
  },
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other"
  ],
  "icon": "media/icon.png",
  "activationEvents": [
    "onView:apiStressStudioView"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "apiStressStudioView",
          "title": "API Stress Studio",
          "icon": "$(pulse)"
        }
      ]
    },
    "views": {
      "apiStressStudioView": [
        {
          "type": "webview",
          "id": "apiStressStudioView",
          "name": "API Stress Studio"
        }
      ]
    },
    "commands": [
      {
        "command": "apiStressStudio.open",
        "title": "API Stress Studio: Open"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.74.0",
    "typescript": "^5.0.0"
  },
  "license": "MIT"
}